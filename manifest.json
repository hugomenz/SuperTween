{
  "manifest_version": 3,
  "name": "SPTween — Tweenvest Tools",
  "version": "0.1.0",
  "description": "Presets de gráficos, chuletas y Dashboard personalizable para Tweenvest.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Abrir SPTween"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://app.tweenvest.com/*",
    "https://*.tweenvest.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.tweenvest.com/*", "https://*.tweenvest.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "commands": {
    "toggle_panel": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Abrir SPTween"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["inject/*.js", "assets/*"],
      "matches": ["https://app.tweenvest.com/*", "https://*.tweenvest.com/*"]
    }
  ]
}
